# ==========================================
# PORTAL DE OBRAS - VARIABLES DE ENTORNO
# ==========================================

# 1. Configuración de NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
# Generar una clave secreta segura (ej: openssl rand -base64 32)
NEXTAUTH_SECRET=tu_secreto_nextauth_ultra_seguro_cambiar_en_produccion

# 2. Credenciales Google Sheets API v4 (Service Account)
# Correo de la cuenta de servicio de Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=portal-de-obras-sa@tu-proyecto-gcp.iam.gserviceaccount.com

# Llave privada RSA descargada del archivo JSON de credenciales de Google Cloud
# Debe incluir las líneas -----BEGIN PRIVATE KEY----- y -----END PRIVATE KEY-----
# En variables de entorno (.env o Vercel), los saltos de línea deben preservarse o escaparse como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Mapeo de IDs de Google Spreadsheets (SHEETS_CONFIG)
# Puede configurarse como JSON string o con variables individuales:
# Formato JSON esperado:
# {"obrasSpreadsheetId":"1ABC...","contratistasSpreadsheetId":"1XYZ...","certificacionesSpreadsheetId":"1DEF..."}
SHEETS_CONFIG='{"obrasSpreadsheetId":"1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890","contratistasSpreadsheetId":"1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890","certificacionesSpreadsheetId":"1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890"}'

# Opcional: IDs individuales alternativos si prefieres no usar el JSON string:
SHEETS_OBRAS_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890
SHEETS_CONTRATISTAS_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890
SHEETS_CERTIFICACIONES_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890

# 4. Configuración de Cache y Revalidación (Data Cache de Next.js)
# Tiempo de expiración del cache de Google Sheets en segundos (default: 300 = 5 minutos)
SHEETS_CACHE_REVALIDATE_SECONDS=300

# 5. Metadata de Aplicación
NEXT_PUBLIC_APP_NAME="Portal de Obras"
NEXT_PUBLIC_APP_VERSION="1.0.0"
