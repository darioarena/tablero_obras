# ==============================================================================
# PORTAL DE OBRAS - VARIABLES DE ENTORNO DE PRODUCCIÓN (VERCEL / LOCAL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTENTICACIÓN Y SESIONES SEGURAS (NextAuth.js)
# ------------------------------------------------------------------------------
# URL canónica de la aplicación (en Vercel se autodetecta si no está definida)
NEXTAUTH_URL=https://tu-proyecto.vercel.app

# Clave secreta para firmar y cifrar tokens JWT de sesión (Mínimo 32 caracteres)
# Generar en terminal con: openssl rand -base64 32
NEXTAUTH_SECRET=tu_clave_secreta_minimo_32_caracteres_aleatorios_1234567890

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS SUPABASE / POSTGRESQL (Usuarios y Permisos en Producción)
# ------------------------------------------------------------------------------
# URL del proyecto en Supabase (Settings -> API -> Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave secreta administrativa de Supabase (Settings -> API -> Project API Keys -> service_role)
# CRÍTICO: Usar service_role para que las Server Actions puedan gestionar usuarios con RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave pública anónima de Supabase (Settings -> API -> Project API Keys -> anon / public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ------------------------------------------------------------------------------
# 3. USUARIO ADMINISTRADOR PRINCIPAL (Auto-creación y Respaldo)
# ------------------------------------------------------------------------------
# Al iniciar con la base de datos vacía, el sistema crea automáticamente este admin con clave hasheada (bcrypt)
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=TuClaveSegura2024!
ADMIN_NAME=Administrador del Sistema

# ------------------------------------------------------------------------------
# 4. CONECTOR GOOGLE SHEETS API v4 (Service Account Backend)
# ------------------------------------------------------------------------------
# Email de la cuenta de servicio de Google Cloud Console
# IMPORTANTE: Compartir cada Google Sheet con este email con permiso de "Lector"
GOOGLE_SERVICE_ACCOUNT_EMAIL=portal-de-obras-sa@tu-proyecto-gcp.iam.gserviceaccount.com

# Clave privada RSA descargada del JSON de Google Cloud
# Debe contener los encabezados -----BEGIN PRIVATE KEY----- y -----END PRIVATE KEY-----
# En Vercel, pegá el contenido completo con los saltos de línea literales
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. IDENTIFICADORES DE PLANILLAS GOOGLE SHEETS
# ------------------------------------------------------------------------------
# El ID se encuentra en la URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SHEETS_OBRAS_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890
SHEETS_CONTRATISTAS_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890
SHEETS_CERTIFICACIONES_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890

# Alternativa: Configuración unificada en formato JSON (opcional):
# SHEETS_CONFIG='{"obrasSpreadsheetId":"1ABC...","contratistasSpreadsheetId":"1XYZ...","certificacionesSpreadsheetId":"1DEF..."}'

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DE RENDIMIENTO Y DATA CACHE
# ------------------------------------------------------------------------------
# Tiempo de expiración del cache de Google Sheets en segundos (default: 300 = 5 minutos)
SHEETS_CACHE_REVALIDATE_SECONDS=300
